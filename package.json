{
  "name": "travelsync",
  "version": "1.0.0",
  "description": "Find your perfect travel companions and create unforgettable journeys together",
  "private": true,
  "author": "TravelSync Team",
  "keywords": [
    "travel",
    "companions",
    "matching",
    "nextjs",
    "react"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
